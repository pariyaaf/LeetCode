   "source": [
    "from typing import List\n",
    "\n",
    "\n",
    "class Solution:\n",
    "    def singleNumber(self, nums: List[int]) -> int:\n",
    "        nums = sorted(nums)\n",
    "        for i in range(0,len(nums),2):\n",
    "            if i+1 == len(nums) or nums[i] != nums[i+1]:\n",
    "                return nums[i]\n"
   ]
  }
