   "source": [
    "class Solution:\n",
    "    def findComplement(self, num: int) -> int:\n",
    "        complement_bin = ''\n",
    "        bin_num =((bin(num))[2:])\n",
    "        for i in bin_num:\n",
    "            s = 1 - int(i)\n",
    "            complement_bin = complement_bin + str(s)\n",
    "        return int(complement_bin,2)"
   ]
  }
