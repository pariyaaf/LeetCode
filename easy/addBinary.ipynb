   "source": [
    "class Solution:\n",
    "    def addBinary(self, a: str, b: str) -> str:\n",
    "        return bin(int(a,2) +  int(b,2))[2:]\n",
    "        \n",
    "s = Solution()\n",
    "print(s.addBinary(a = \"11\", b = \"1\"))\n",
    "print(s.addBinary( a = \"1010\", b = \"1011\"))"
   ]
